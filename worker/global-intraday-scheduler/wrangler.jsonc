{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "jkquant-global-intraday-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "vars": {
    "BASE_URL": "https://jkquant.pages.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAPER_STORE",
        "class_name": "PaperStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PaperStore"]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
