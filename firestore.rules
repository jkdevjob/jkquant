rules_version = '2';

/* JK 퀀트 — Firestore 보안 규칙
   Firebase 콘솔 → Firestore Database → 규칙 에 이 내용을 붙여넣고 게시한다.

   왜 필요한가: 앱의 차단 기능은 로그인 직후 클라이언트가 스스로 확인하는 수준이라,
   규칙이 없으면 차단된 사람이 앱을 거치지 않고 데이터를 읽는 걸 막지 못한다.
   관리자 목록 조회(profiles 전체 읽기)도 규칙이 허용해야 동작한다.

   컬렉션 두 개:
     users/{uid}    — 그 사람의 전략·거래기록 전부. 본인만 읽고 쓴다. 관리자도 안 본다.
     profiles/{uid} — 이메일·접속시각처럼 목록에 필요한 것만. 관리자가 전체를 읽는다. */

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn()  { return request.auth != null; }
    function isAdmin()     { return isSignedIn() && request.auth.token.email == 'jk82investing@gmail.com'; }
    function isMine(uid)   { return isSignedIn() && request.auth.uid == uid; }
    function notBlocked()  {
      // 차단 표시가 있으면 자기 데이터도 못 연다. 관리자는 이 검사에서 빠진다
      return isAdmin() || !exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
             || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.blocked != true;
    }

    // 거래기록은 남이 못 본다 — 관리자도 마찬가지다
    match /users/{uid} {
      allow read, write: if isMine(uid) && notBlocked();
    }

    match /profiles/{uid} {
      allow get:  if isMine(uid) || isAdmin();
      allow list: if isAdmin();                       // 사용자 목록은 관리자만
      // 본인은 접속 기록만 갱신한다. blocked를 스스로 건드리면 차단이 무의미해진다
      allow create: if isMine(uid) && !('blocked' in request.resource.data);
      allow update: if isMine(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['blocked']);
      allow write:  if isAdmin();                     // 차단·해제는 관리자만
    }
  }
}
